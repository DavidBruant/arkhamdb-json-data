{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://arkham-horror-lcg-schemas.invalid/schema/pack_schema.json",
    "additionalProperties": false,
    "properties": {
        "code": {
            "minLength": 1,
            "type": "string"
        },
        "cycle_code": {
            "minLength": 1,
            "type": "string"
        },
        "date_release": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
        },
        "cgdb_id": {
            "oneOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ]
        },
        "chapter": {
            "type": "integer"
        },
        "replaced": {
            "type": "boolean"
        },
        "reprint_packs": {
            "type": "array"
        },
        "reprint_type": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "minLength": 1,
            "type": "string"
        },
        "position": {
            "minimum": 1,
            "type": "integer"
        },
        "size": {
            "oneOf": [
                {
                    "minimum": 1,
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "code",
        "cycle_code",
        "name",
        "position",
        "date_release",
        "size"
    ],
    "type": "object"
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://arkham-horror-lcg-schemas.invalid/schema/cycle_schema.json",
    "type": "object",
    "required": ["code", "name", "position", "size"],
    "additionalProperties": false,
    "properties": {
        "code": {
            "minLength": 1,
            "type": "string"
        },
        "name": {
            "minLength": 1,
            "type": "string"
        },
        "position": {
            "minimum": 0,
            "type": "integer"
        },
        "size": {
            "minimum": 1,
            "type": "integer"
        }
    }
}
